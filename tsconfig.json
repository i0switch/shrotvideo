{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
  "noImplicitAny": false,
  "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
  "noUnusedLocals": true,
  "strictNullChecks": true
  }
}
