{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppSpec",
  "type": "object",
  "name": "vite_react_shadcn_ts",
  "version": "0.0.0",
  "platforms": {
    "youtube": {
      "status": "ok",
      "selectors": {},
      "login": {},
      "outputMode": "background_composite"
    },
    "tiktok": {
      "status": "ok",
      "selectors": {},
      "login": {},
      "outputMode": "background_composite"
    },
    "x": {
      "status": "needs_fix",
      "selectors": {},
      "login": {},
      "outputMode": "screenshot_overlay"
    }
  },
  "pipelines": [
    {
      "name": "youtube_pipeline",
      "steps": [
        "listRecent",
        "download",
        "generate"
      ],
      "entry": "npm run gemini:generate -- --platform youtube"
    },
    {
      "name": "tiktok_pipeline",
      "steps": [
        "listRecent",
        "download",
        "generate"
      ],
      "entry": "npm run gemini:generate -- --platform tiktok"
    },
    {
      "name": "x_pipeline",
      "steps": [
        "listRecent",
        "screenshot",
        "generate"
      ],
      "entry": "npm run gemini:generate -- --platform x"
    }
  ],
  "settings": {
    "outputDir": "test-results/auto-gen",
    "screenshotDir": "test-results/auto-gen/x-shots",
    "headless": true,
    "timeoutMs": 60000,
    "ffmpeg": {
      "bin": "C:\\Users\\i0swi\\OneDrive\\デスクトップ\\dougadownload\\node_modules\\ffmpeg-static\\ffmpeg.exe",
      "templatesDir": ""
    }
  }
}