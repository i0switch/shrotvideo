{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["dom", "es2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["app/core/*"],
      "@main/*": ["app/main/*"],
      "@renderer/*": ["app/renderer/*"],
      "@config/*": ["config/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "exclude": ["dist", "release", "node_modules"]
}
