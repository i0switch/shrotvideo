{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "description": "ShortVideo-Genius",
  "author": "Your Name <your.email@example.com>",
  "homepage": "./",
  "main": "electron-entry.cjs",
  "scripts": {
    "dev": "vite --strictPort --force",
    "start": "npm run build:electron && npx cross-env NODE_ENV=development concurrently \"npm:dev\" \"wait-on http://127.0.0.1:5173 && npx electron .\"",
    "start:preview": "npm run build:electron && npx cross-env NODE_ENV=development PREVIEW_ON_START=1 PREVIEW_FILE=test-data/background.mp4 PREVIEW_EXIT=1 concurrently \"npm:dev\" \"wait-on http://127.0.0.1:5173 && npx electron .\"",
    "build": "npm run clean && npm run build:renderer && npm run build:electron && electron-builder --publish=never",
  "dist:win": "npm run build:renderer && npm run build:electron && electron-builder --win --publish=never",
  "dist:mac": "npm run build:renderer && npm run build:electron && electron-builder --mac --publish=never",
  "postinstall": "node scripts/postinstall-playwright.cjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/postbuild-electron.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npx vitest",
    "test:unit": "vitest run",
    "test:e2e": "npx playwright test",
    "dist": "electron-builder",
    "package": "npm run build && npm run dist",
    "clean": "npx rimraf dist release",
    "run:urls": "node ./dist/electron/electron/tools/generate-from-urls.js",
    "run:batch": "node ./dist/electron/electron/tools/generate-batch-accounts.js",
    "start:prod": "npm run build:renderer && npm run build:electron && npx cross-env NODE_ENV=production npx electron .",
    "test:autorun": "npm run build:renderer && npm run build:electron && npx cross-env RUN_TEST_ON_START=1 RUN_TEST_EXIT=1 NODE_ENV=production npx electron .",
    "gemini:spec": "node scripts/gemini.cjs spec",
    "gemini:generate": "node scripts/gemini.cjs generate",
    "gemini:all": "node scripts/gemini.cjs all",
    "capture:x": "node scripts/capture-x-posts.cjs"
  },
  "build": {
    "appId": "com.gemini.shortvideotool",
  "productName": "ShortVideo-Genius",
    "electronVersion": "37.4.0",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ytdlp-nodejs/**",
  "node_modules/playwright-core/.local-browsers/**",
      "screenshot/.auth/**",
      "screenshot/out/screenshots/**"
    ],
    "files": [
      "dist/",
      "package.json",
      "electron-entry.cjs",
      "scripts/run-screenshot-grab.cjs",
  "node_modules/ytdlp-nodejs/**",
  "node_modules/ffmpeg-static/**",
  "node_modules/playwright-core/**",
  "node_modules/playwright-core/.local-browsers/**",
      "screenshot/**",
  "ms-playwright/**",
      "!node_modules/playwright/**",
      "!**/node_modules/playwright/**",
      "!node_modules/playwright/node_modules/fsevents/**",
      "!node_modules/playwright/node_modules/**",
      "!**/node_modules/**/fsevents/**",
      "!**/fsevents/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
