{
  "name": "x-screenshot-cli",
  "version": "1.0.0",
  "description": "A CLI tool to capture screenshots of X posts.",
  "main": "dist/cli.js",
  "scripts": {
    "start": "pnpm grab",
    "grab": "npx tsx src/cli.ts grab",
    "login": "npx tsx src/cli.ts login",
    "test": "npx playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "x",
    "twitter",
    "screenshot",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.45.0",
    "sharp": "^0.33.4",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}